{
  "$schema": "../../templates/component-starter/manifest.schema.json",
  "schemaVersion": 1,
  "version": "1.0.0",
  "author": {
    "name": "dotbench",
    "url": "https://dotbench.app"
  },
  "license": "GPL-3.0-or-later",
  "id": "dotbench.potentiometer",
  "name": {
    "en": "Potentiometer 10 kΩ",
    "pt-BR": "Potenciômetro 10 kΩ",
    "es": "Potenciómetro 10 kΩ"
  },
  "description": {
    "en": "A 10 kΩ rotary potentiometer. Wire T to 3V3, B to GND and read the wiper W on an analog pin (EXP8 to EXP12, EXP14).",
    "pt-BR": "Um potenciômetro rotativo de 10 kΩ. Ligue T em 3V3, B no GND e leia o cursor W em um pino analógico (EXP8 a EXP12, EXP14).",
    "es": "Un potenciómetro rotativo de 10 kΩ. Conecta T a 3V3, B a GND y lee el cursor W en un pin analógico (EXP8 a EXP12, EXP14)."
  },
  "category": "input",
  "tags": [
    "potentiometer",
    "analog",
    "input"
  ],
  "picture": {
    "file": "picture.svg",
    "width": 145,
    "height": 110
  },
  "pins": [
    {
      "name": "T",
      "kind": "analog",
      "pos": {
        "x": 21.9,
        "y": 100
      },
      "abs_max_mv": 5500,
      "mm": {
        "x": 2.19,
        "y": 10,
        "z": 0
      },
      "face": "bottom"
    },
    {
      "name": "W",
      "kind": "analog",
      "pos": {
        "x": 72.7,
        "y": 100
      },
      "abs_max_mv": 5500,
      "mm": {
        "x": 7.27,
        "y": 10,
        "z": 0
      },
      "face": "bottom"
    },
    {
      "name": "B",
      "kind": "analog",
      "pos": {
        "x": 123.5,
        "y": 100
      },
      "abs_max_mv": 5500,
      "mm": {
        "x": 12.35,
        "y": 10,
        "z": 0
      },
      "face": "bottom"
    }
  ],
  "fields": [
    {
      "name": "position",
      "type": "number",
      "label": {
        "en": "Position",
        "pt-BR": "Posição",
        "es": "Posición"
      },
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.5,
      "ui": "knob"
    }
  ],
  "controls": [
    {
      "field": "position",
      "region": {
        "x": 24.2,
        "y": 11,
        "w": 96.7,
        "h": 66
      },
      "mode": "rotate"
    }
  ],
  "visuals": [
    {
      "id": "knob",
      "effect": "rotate",
      "x": 72.5,
      "y": 44,
      "r": 26.4,
      "source": {
        "field": "position"
      },
      "scale": {
        "in": [
          0,
          1
        ],
        "out": [
          -135,
          135
        ]
      }
    }
  ],
  "behaviour": {
    "type": "declarative",
    "engine": 1,
    "elements": [
      {
        "type": "divider",
        "top": "T",
        "bottom": "B",
        "wiper": "W",
        "ohms": 10000,
        "position": {
          "field": "position"
        }
      }
    ]
  },
  "body": {
    "w_mm": 14.5,
    "d_mm": 11,
    "h_mm": 16
  },
  "keywords": {
    "en": [
      "potentiometer",
      "knob",
      "analog",
      "resistor",
      "dial"
    ],
    "pt-BR": [
      "potenciômetro",
      "botão giratório",
      "analógico",
      "resistor"
    ],
    "es": [
      "potenciómetro",
      "perilla",
      "analógico",
      "resistencia"
    ]
  }
}

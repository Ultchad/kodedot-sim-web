{
  "$schema": "../../templates/component-starter/manifest.schema.json",
  "schemaVersion": 1,
  "id": "dotbench.kode-camera-shape",
  "name": {
    "en": "Kode Camera module (shape only)",
    "pt-BR": "Kode Camera module (só a forma)",
    "es": "Kode Camera module (solo la forma)"
  },
  "version": "1.0.0",
  "author": {
    "name": "dotbench",

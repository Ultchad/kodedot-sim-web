{
  "$schema": "../../templates/component-starter/manifest.schema.json",
  "schemaVersion": 1,
  "id": "dotbench.kode-mesh-shape",
  "name": {
    "en": "Kode Mesh module (shape only)",
    "pt-BR": "Kode Mesh module (só a forma)",
    "es": "Kode Mesh module (solo la forma)"
  },
  "version": "1.0.0",
  "author": {
    "name": "dotbench",
    "url": "https://dotbench.app"
  },
  "license": "GPL-3.0-or-later",
  "description": {
    "en": "SHAPE ONLY: it mounts on the header and passes the rails and the 14 signal terminals through, and does nothing else. The LoRa radio (LR2021) and the GNSS receiver is not simulated: no behaviour, no chip, no bus device. The pin names follow the published pin map.",
    "pt-BR": "SÓ A FORMA: encaixa no cabeçalho e repassa os trilhos e os 14 terminais de sinal, e nada mais. The LoRa radio (LR2021) and the GNSS receiver não é simulado: sem comportamento, sem chip, sem dispositivo de barramento. Os nomes dos pinos seguem o mapa publicado.",
    "es": "SOLO LA FORMA: encaja en el cabezal y pasa los rieles y los 14 terminales de señal, y nada más. The LoRa radio (LR2021) and the GNSS receiver no se simula: sin comportamiento, sin chip, sin dispositivo de bus. Los nombres de los pines siguen el mapa publicado."
  },
  "category": "kode-module",
  "tags": [
    "kode",
    "module",
    "shape-only",
    "mesh",
    "lora"
  ],
  "keywords": {
    "en": [
      "mesh",
      "lora",
      "gnss",
      "kode",
      "module",
      "shape only"
    ],
    "pt-BR": [
      "mesh",
      "lora",
      "gnss",
      "kode",
      "módulo",
      "só a forma"
    ],
    "es": [
      "mesh",
      "lora",
      "gnss",
      "kode",
      "módulo",
      "solo la forma"
    ]
  },

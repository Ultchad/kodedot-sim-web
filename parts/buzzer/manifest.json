{
  "$schema": "../../templates/component-starter/manifest.schema.json",
  "schemaVersion": 1,
  "version": "1.0.0",
  "author": {
    "name": "dotbench",
    "url": "https://dotbench.app"
  },
  "license": "GPL-3.0-or-later",
  "id": "dotbench.buzzer",
  "name": {
    "en": "Passive buzzer",
    "pt-BR": "Buzzer passivo",
    "es": "Zumbador pasivo"
  },
  "description": {
    "en": "A passive piezo buzzer: drive P with PWM (the frequency is the pitch), N to GND. The bench shows the pitch in Hz; it does not play sound by itself.",
    "pt-BR": "Um buzzer piezo passivo: acione P com PWM (a frequência é a nota), N no GND. A bancada mostra a nota em Hz; ela não toca som sozinha.",
    "es": "Un zumbador piezo pasivo: activa P con PWM (la frecuencia es la nota), N a GND. La mesa muestra la nota en Hz; no reproduce sonido por sí sola."
  },
  "category": "actuator",
  "tags": [
    "buzzer",
    "pwm",
    "sound"
  ],
  "picture": {
    "file": "picture.svg",
    "width": 156,
    "height": 156
  },
  "pins": [
    {
      "name": "P",
      "kind": "io",
      "pos": {
        "x": 28.6,
        "y": 78
      },
      "abs_max_mv": 5500,
      "mm": {
        "x": 2.2,
        "y": 6
      },
      "face": "bottom"
    },
    {
      "name": "N",
      "kind": "io",
      "pos": {
        "x": 127.4,
        "y": 78
      },
      "abs_max_mv": 5500,
      "mm": {
        "x": 9.8,
        "y": 6
      },
      "face": "bottom"
    }
  ],
  "outputs": [
    {
      "name": "hz",
      "type": "number",
      "unit": "Hz",
      "min": 0,
      "max": 40000,
      "label": {
        "en": "Pitch",
        "pt-BR": "Nota",
        "es": "Nota"
      }
    }
  ],
  "visuals": [
    {
      "id": "pitch",
      "effect": "text",
      "x": 60,
      "y": 46,
      "w": 80,
      "h": 22,
      "color": "#ffffff",
      "source": {
        "output": "hz"
      }
    }
  ],
  "behaviour": {
    "type": "declarative",
    "engine": 1,
    "elements": [
      {
        "type": "buzzer",
        "pin": "P",
        "ref": "N",
        "output": "hz"
      }
    ]
  },
  "body": {
    "w_mm": 12,
    "d_mm": 12,
    "h_mm": 9.5
  },
  "keywords": {
    "en": [
      "buzzer",
      "beep",
      "sound",
      "piezo",
      "speaker"
    ],
    "pt-BR": [
      "buzzer",
      "campainha",
      "som",
      "piezo",
      "alto-falante"
    ],
    "es": [
      "zumbador",
      "buzzer",
      "sonido",
      "piezo",
      "altavoz"
    ]
  }
}

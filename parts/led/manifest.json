{
  "$schema": "../../templates/component-starter/manifest.schema.json",
  "schemaVersion": 1,
  "version": "1.0.0",
  "author": {
    "name": "dotbench",
    "url": "https://dotbench.app"
  },
  "license": "GPL-3.0-or-later",
  "id": "dotbench.led",
  "name": {
    "en": "LED with resistor",
    "pt-BR": "LED com resistor",
    "es": "LED con resistencia"
  },
  "description": {
    "en": "A red 5 mm LED with its own series resistor (the Resistor field, 330 ohm by default). Anode to a GPIO (or a rail), cathode to GND, no other resistor needed. It conducts above 1.9 V and glows by the current the circuit gives it: 10 mA is full brightness.",
    "pt-BR": "Um LED vermelho de 5 mm com o próprio resistor em série (campo Resistor, 330 ohm por padrão). Anodo em um GPIO (ou trilho), catodo no GND, sem outro resistor. Conduz acima de 1,9 V e brilha pela corrente que o circuito entrega: 10 mA é brilho total.",
    "es": "Un LED rojo de 5 mm con su propia resistencia en serie (campo Resistencia, 330 ohm por defecto). Ánodo a un GPIO (o riel), cátodo a GND, sin otra resistencia. Conduce por encima de 1,9 V y brilla según la corriente del circuito: 10 mA es brillo máximo."
  },
  "category": "actuator",
  "tags": [
    "led",
    "output"
  ],
  "picture": {
    "file": "picture.svg",
    "width": 151,
    "height": 151
  },
  "pins": [
    {
      "name": "A",
      "kind": "io",
      "pos": {
        "x": 42.4,
        "y": 75.4
      },
      "label": {
        "en": "A"
      },
      "abs_max_mv": 5500,
      "mm": {
        "x": 1.63,
        "y": 2.9,
        "z": 0
      },
      "face": "bottom"
    },
    {
      "name": "K",
      "kind": "io",
      "pos": {
        "x": 108.4,
        "y": 75.4
      },
      "label": {
        "en": "K"
      },
      "abs_max_mv": 5500,
      "mm": {
        "x": 4.17,
        "y": 2.9,
        "z": 0
      },
      "face": "bottom"
    }
  ],
  "fields": [
    {
      "name": "ohms",
      "type": "number",
      "label": {
        "en": "Resistor",
        "pt-BR": "Resistor",
        "es": "Resistencia"
      },
      "min": 0,
      "max": 10000,
      "step": 10,
      "unit": "Ω",
      "default": 330,
      "ui": "input"
    }
  ],
  "outputs": [
    {
      "name": "brightness",
      "type": "number",
      "min": 0,
      "max": 1,
      "label": {
        "en": "Brightness",
        "pt-BR": "Brilho",
        "es": "Brillo"
      }
    }
  ],
  "visuals": [
    {
      "id": "glow",
      "effect": "glow",
      "x": 75.5,
      "y": 48.3,
      "r": 30.2,
      "color": "#ff3b30",
      "source": {
        "output": "brightness"
      }
    }
  ],
  "behaviour": {
    "type": "declarative",
    "engine": 1,
    "elements": [
      {
        "type": "diode",
        "anode": "A",
        "cathode": "K",
        "vf_mv": 1900,
        "rs_ohms": 10,
        "series_ohms": {
          "field": "ohms"
        },
        "full_ma": 10,
        "output": "brightness"
      }
    ]
  },
  "body": {
    "w_mm": 5.8,
    "d_mm": 5.8,
    "h_mm": 9
  },
  "keywords": {
    "en": [
      "led",
      "light",
      "indicator",
      "diode"
    ],
    "pt-BR": [
      "led",
      "luz",
      "indicador",
      "diodo"
    ],
    "es": [
      "led",
      "luz",
      "indicador",
      "diodo"
    ]
  }
}

{
  "name": "blink and UART echo",
  "steps": [
    {
      "advance_ms": 50
    },
    {
      "expect_serial": "echoing UART1"
    },
    {
      "comment": "greeting on UART1",
      "expect_uart": {
        "contains": "ESP32 ready"
      }
    },
    {

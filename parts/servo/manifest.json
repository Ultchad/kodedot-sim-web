{
  "$schema": "../../templates/component-starter/manifest.schema.json",
  "schemaVersion": 1,
  "version": "1.0.0",
  "author": {
    "name": "dotbench",
    "url": "https://dotbench.app"
  },
  "license": "GPL-3.0-or-later",
  "id": "dotbench.servo",
  "name": {
    "en": "Hobby servo (SG90 class)",
    "pt-BR": "Servo hobby (classe SG90)",
    "es": "Servo de hobby (clase SG90)"
  },
  "description": {
    "en": "A 180 degree hobby servo: 5 V on V5, GND, and a 50 Hz PWM signal on SIG. The horn follows the pulse width the way the Arduino Servo library drives it: 544 us is 0 degrees, 2400 us is 180 (so Servo.write(90) lands at 90). Needs the 5 V rail switched on.",
    "pt-BR": "Um servo hobby de 180 graus: 5 V em V5, GND e um sinal PWM de 50 Hz em SIG. O eixo segue a largura de pulso como a biblioteca Servo do Arduino a gera: 544 us é 0 grau, 2400 us é 180 (então Servo.write(90) chega a 90). Precisa do trilho de 5 V ligado.",
    "es": "Un servo de hobby de 180 grados: 5 V en V5, GND y una señal PWM de 50 Hz en SIG. El eje sigue el ancho de pulso como lo genera la biblioteca Servo de Arduino: 544 us es 0 grados, 2400 us es 180 (así Servo.write(90) llega a 90). Necesita el riel de 5 V encendido."
  },
  "category": "actuator",
  "tags": [
    "servo",
    "pwm",
    "motor"
  ],
  "picture": {
    "file": "picture.svg",
    "width": 418,
    "height": 320
  },
  "pins": [
    {
      "name": "GND",
      "kind": "ground",
      "pos": {
        "x": 0,
        "y": 140.5
      },
      "mm": {
        "x": 0,
        "y": 17.56,
        "z": 4
      },
      "face": "left"
    },
    {
      "name": "V5",
      "kind": "power_in",
      "pos": {
        "x": 0,
        "y": 160.8
      },
      "min_mv": 4000,
      "max_mv": 6000,
      "typ_ma": 150,
      "mm": {
        "x": 0,
        "y": 20.1,
        "z": 4
      },
      "face": "left"
    },
    {
      "name": "SIG",
      "kind": "io",
      "pos": {
        "x": 0,
        "y": 181.1
      },
      "abs_max_mv": 5500,
      "mm": {
        "x": 0,
        "y": 22.64,
        "z": 4
      },
      "face": "left"
    }
  ],
  "outputs": [
    {
      "name": "angle",
      "type": "number",
      "unit": "°",
      "min": 0,
      "max": 180,
      "label": {
        "en": "Angle",
        "pt-BR": "Ângulo",
        "es": "Ángulo"
      }
    }
  ],
  "visuals": [
    {
      "id": "horn",
      "effect": "rotate",
      "x": 248,
      "y": 160,
      "r": 80,
      "source": {
        "output": "angle"
      },
      "scale": {
        "in": [
          0,
          180
        ],
        "out": [
          -90,
          90
        ]
      }
    }
  ],
  "behaviour": {
    "type": "declarative",
    "engine": 1,
    "elements": [
      {
        "type": "servo",
        "pin": "SIG",
        "output": "angle",
        "min_us": 544,
        "max_us": 2400,
        "range_deg": 180
      }
    ]
  },
  "body": {
    "w_mm": 52.3,
    "d_mm": 40,
    "h_mm": 31.8
  },
  "keywords": {
    "en": [
      "servo",
      "sg90",
      "motor",
      "angle",
      "pwm",
      "arduino servo"
    ],
    "pt-BR": [
      "servo",
      "sg90",
      "motor",
      "ângulo",
      "pwm"
    ],
    "es": [
      "servo",
      "sg90",
      "motor",
      "ángulo",
      "pwm"
    ]
  }
}

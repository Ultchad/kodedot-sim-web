{
  "$schema": "../../templates/component-starter/manifest.schema.json",
  "schemaVersion": 1,
  "version": "1.0.0",
  "author": {
    "name": "dotbench",
    "url": "https://dotbench.app"
  },
  "license": "GPL-3.0-or-later",
  "id": "dotbench.servo",
  "name": {
    "en": "Hobby servo (SG90 class)",
    "pt-BR": "Servo hobby (classe SG90)",
    "es": "Servo de hobby (clase SG90)"
  },
  "description": {
    "en": "A 180 degree hobby servo: 5 V on V5, GND, and a 50 Hz PWM signal on SIG (1 ms is 0 degrees, 2 ms is 180). Needs the 5 V rail switched on.",
    "pt-BR": "Um servo hobby de 180 graus: 5 V em V5, GND e um sinal PWM de 50 Hz em SIG (1 ms é 0 grau, 2 ms é 180). Precisa do trilho de 5 V ligado.",
    "es": "Un servo de hobby de 180 grados: 5 V en V5, GND y una señal PWM de 50 Hz en SIG (1 ms es 0 grados, 2 ms es 180). Necesita el riel de 5 V encendido."
  },
  "category": "actuator",
  "tags": [
    "servo",
    "pwm",
    "motor"
  ],
  "picture": {
    "file": "picture.svg",
    "width": 200,
    "height": 150
  },
  "pins": [
    {
      "name": "GND",
      "kind": "ground",
      "pos": {
        "x": 55,
        "y": 134
      }
    },
    {
      "name": "V5",
      "kind": "power_in",
      "pos": {
        "x": 100,
        "y": 134
      },
      "min_mv": 4000,
      "max_mv": 6000,
      "typ_ma": 150
    },
    {
      "name": "SIG",
      "kind": "io",
      "pos": {
        "x": 145,
        "y": 134
      },
      "abs_max_mv": 5500
    }
  ],
  "outputs": [
    {
      "name": "angle",
      "type": "number",
      "unit": "°",
      "min": 0,
      "max": 180,
      "label": {
        "en": "Angle",
        "pt-BR": "Ângulo",
        "es": "Ángulo"
      }
    }
  ],
  "visuals": [
    {
      "id": "horn",
      "effect": "rotate",
      "x": 100,
      "y": 60,
      "r": 40,
      "source": {
        "output": "angle"
      },
      "scale": {
        "in": [
          0,
          180
        ],
        "out": [
          -90,
          90
        ]
      }
    }
  ],
  "behaviour": {
    "type": "declarative",
    "engine": 1,
    "elements": [
      {
        "type": "servo",
        "pin": "SIG",
        "output": "angle",
        "min_us": 1000,
        "max_us": 2000,
        "range_deg": 180
      }
    ]
  }
}

  "id": "dotbench.stepper-a4988",
  "name": {
    "en": "NEMA 17 stepper + A4988",
    "pt-BR": "Motor de passo NEMA 17 + A4988",
    "es": "Motor paso a paso NEMA 17 + A4988"

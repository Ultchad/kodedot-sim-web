    {"name":"RST","kind":"io","pos":{"x":116.6,"y":25},"mm":{"x":11.66,"y":2.5},"face":"top","label":{"en":"RST"},"abs_max_mv":5500,"pullup_ohms":100000,"pull_rail":"VDD"},

{
  "$schema": "../../templates/component-starter/manifest.schema.json",
  "schemaVersion": 1,
  "id": "dotbench.kode-hacking-shape",
  "name": {
    "en": "Kode hacking module (shape only)",
    "pt-BR": "Kode hacking module (só a forma)",

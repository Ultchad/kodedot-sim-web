  "id": "dotbench.esp32-button-led",
  "name": {
    "en": "ESP32: button toggles LED",
    "pt-BR": "ESP32: botão alterna LED",
    "es": "ESP32: botón alterna LED"
  },
  "version": "1.0.0",
  "author": {
    "name": "dotbench",

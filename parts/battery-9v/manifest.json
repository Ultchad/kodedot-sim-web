{
  "$schema": "../../templates/component-starter/manifest.schema.json",
  "schemaVersion": 1,
  "id": "dotbench.battery-9v",
  "name": {
    "en": "9 V battery",
    "pt-BR": "Bateria de 9 V",
    "es": "Batería de 9 V"
  },
  "version": "1.0.0",
  "author": {
    "name": "dotbench",
    "url": "https://dotbench.app"
  },
  "license": "GPL-3.0-or-later",
  "description": {
    "en": "A 9 V (PP3) battery: a floating voltage source, the voltage is a field, 2 ohm internal resistance. Its minus pin is the 0 V of any circuit it makes on its own. Above 500 mA the bench shows an overload hazard; a wire from plus to minus is a short. The charge does not run down.",
    "pt-BR": "Uma bateria de 9 V (PP3): uma fonte de tensão flutuante, a tensão é um campo, resistência interna de 2 ohm. O pino negativo é o 0 V de qualquer circuito que ela forme sozinha. Acima de 500 mA a bancada mostra aviso de sobrecarga; um fio do positivo ao negativo é um curto. A carga não acaba.",
    "es": "Una batería de 9 V (PP3): una fuente de tensión flotante, la tensión es un campo, resistencia interna de 2 ohm. Su pin negativo es el 0 V de cualquier circuito que forme por sí sola. Por encima de 500 mA el banco muestra aviso de sobrecarga; un cable del positivo al negativo es un cortocircuito. La carga no se agota."
  },
  "category": "power",
  "tags": [
    "battery",
    "9v",
    "power",
    "source"
  ],
  "keywords": {
    "en": [
      "battery",
      "9v",
      "pp3",
      "power",
      "supply",
      "cell"
    ],
    "pt-BR": [
      "bateria",
      "pilha",
      "9v",
      "fonte",
      "alimentação"
    ],
    "es": [
      "batería",
      "pila",
      "9v",
      "fuente",
      "alimentación"
    ]
  },
  "body": {
    "w_mm": 26.5,
    "d_mm": 17.5,
    "h_mm": 48.5
  },
  "picture": {
    "file": "picture.svg",
    "width": 265,
    "height": 175
  },
  "pins": [
    {"name":"POS","kind":"io","pos":{"x":70,"y":87.5},"mm":{"x":7,"y":8.75,"z":48.5},"face":"top","label":{"en":"+"},"abs_max_mv":60000},
    {"name":"NEG","kind":"io","pos":{"x":197,"y":87.5},"mm":{"x":19.7,"y":8.75,"z":48.5},"face":"top","label":{"en":"-"},"abs_max_mv":60000}
  ],
  "fields": [
    {
      "name": "volts",
      "type": "number",
      "label": {
        "en": "Voltage",
        "pt-BR": "Tensão",
        "es": "Tensión"
      },
      "min": 0,
      "max": 12,
      "step": 0.1,
      "unit": "V",
      "default": 9,
      "ui": "input"
    }
  ],
  "outputs": [
    {
      "name": "current_ma",
      "type": "number",
      "unit": "mA",
      "label": {
        "en": "Current",
        "pt-BR": "Corrente",
        "es": "Corriente"
      }
    },
    {
      "name": "overload",
      "type": "boolean",
      "label": {
        "en": "Overload (above 500 mA or shorted)",
        "pt-BR": "Sobrecarga (acima de 500 mA ou em curto)",
        "es": "Sobrecarga (por encima de 500 mA o en corto)"
      }
    }
  ],
  "visuals": [
    {
      "id": "value",
      "effect": "text",
      "x": 132,
      "y": 88,
      "color": "#1d2a38",
      "source": {
        "field": "volts"
      }
    }
  ],
  "behaviour": {
    "type": "declarative",
    "engine": 1,
    "elements": [
      {
        "type": "cell",
        "pos": "POS",
        "neg": "NEG",
        "mv": {
          "field": "volts",
          "scale": 1000
        },
        "ohms": 2,
        "max_ma": 500,
        "current_output": "current_ma",
        "overload_output": "overload"
      }
    ]
  }
}

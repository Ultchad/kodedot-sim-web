#!/usr/bin/env python3
"""dotbench: build kode-sdk C apps for the browser test bench.

  dotbench sdk                      precompile SDK + LVGL + QP/C + runtime into static libraries
  dotbench build APPDIR [-o OUT]    compile an app's main/ sources, link, package OUT/<name>.zip (and <name>.dotbench)
  dotbench seed OLD_BUILD_DIR       copy an existing build dir into --build (new worktree starts warm)
  dotbench areas                    list hardware areas (runtime/drivers/*/area.json)

Role "kodeos" (kodeOS, the operating system, instead of an app):
  dotbench sdk --role kodeos                    SDK + LVGL + ThorVG + runtime for the OS role into <build>/kodeos/
  dotbench build KODEOS_DIR --role kodeos       also kgui and kodeOS's main, link, package kodeos.dotbench
  --kodeos / DOTBENCH_KODEOS  kodeOS checkout (default /home/claude/src/KodeOS)

Paths come from arguments or environment variables:
  --sdk   / DOTBENCH_SDK    kode-sdk checkout          (default /home/claude/src/kode-sdk)
  --lvgl  / DOTBENCH_LVGL   LVGL checkout              (default <sdk>/../third/lvgl)
  --emsdk / DOTBENCH_EMSDK  Emscripten SDK             (default /home/claude/tools/emsdk)
  --build / DOTBENCH_BUILD  build directory            (default <dotbench>/build)
The SDK and LVGL trees are only read; nothing is ever written into them.
"""
import argparse
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import zipfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from dblib import sources as S          # noqa: E402
from dblib import toolchain as T        # noqa: E402
from dblib import areas as A            # noqa: E402
from dblib import kodeos as K          # noqa: E402
from dblib import appdata as AD        # noqa: E402

PINNED_SDK_COMMIT = "c9568a3"


def paths(a):
    sdk = pathlib.Path(a.sdk or os.environ.get("DOTBENCH_SDK", "/home/claude/src/kode-sdk")).resolve()
    lvgl = pathlib.Path(a.lvgl or os.environ.get("DOTBENCH_LVGL", str(sdk.parent / "third" / "lvgl"))).resolve()
    emsdk = pathlib.Path(a.emsdk or os.environ.get("DOTBENCH_EMSDK", "/home/claude/tools/emsdk"))
    build = pathlib.Path(a.build or os.environ.get("DOTBENCH_BUILD", str(ROOT / "build"))).resolve()
    for p, n in ((sdk, "SDK"), (lvgl, "LVGL")):
        if not p.is_dir():
            sys.exit("dotbench: %s not found at %s" % (n, p))
    if str(build).startswith(str(sdk)) or str(build).startswith(str(lvgl)):
        sys.exit("dotbench: refusing to build inside the SDK/LVGL tree")
    build.mkdir(parents=True, exist_ok=True)
    T.set_context(root=ROOT, sdk=sdk, lvgl=lvgl, build=build)
    T.load_hash_cache(build / "hashcache.json")
    (build / "build-meta.json").write_text(json.dumps({"root": str(ROOT), "build": str(build)}))
    return sdk, lvgl, emsdk, build


def sdk_commit(sdk):
    r = subprocess.run(["git", "-C", str(sdk), "rev-parse", "--short", "HEAD"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else "unknown"


# ---- configuration ---------------------------------------------------------------

def ensure_config(sdk, lvgl, build, areas, kos=None):
    """kos: the kodeOS checkout for the "kodeos" role (its sdkconfig.defaults and kgui's Kconfig), else None."""
    build.mkdir(parents=True, exist_ok=True)
    adef = build / "areas.sdkconfig.defaults"
    txt = A.area_sdkconfig(areas)
    if not adef.exists() or adef.read_text() != txt:
        adef.write_text(txt)
    hdr, js = build / "sdkconfig.h", build / "sdkconfig.json"
    if kos is None:
        role_defaults = [ROOT / "runtime/idf/sdkconfig.web.defaults"]
        role_kconfig = []
    else:
        role_defaults = [K.os_defaults(kos), K.web_defaults(ROOT)]
        role_kconfig = K.kconfigs(kos)
    inputs = [ROOT / "tools/gen_sdkconfig.py"] + role_defaults + [sdk / "components/kbsp/sdkconfig.board", lvgl / "Kconfig"]
    inputs += role_kconfig
    inputs += sorted(sdk.glob("components/**/Kconfig*")) + [adef]
    stamp = build / "sdkconfig.stamp"
    h = T.file_hash(inputs)
    if not (hdr.exists() and js.exists() and stamp.exists() and stamp.read_text() == h):
        cmd = [sys.executable, str(ROOT / "tools/gen_sdkconfig.py"), "--sdk", str(sdk),
               "--kconfig", str(lvgl / "Kconfig")]
        for k in role_kconfig:
            cmd += ["--kconfig", str(k)]
        cmd += ["--defaults", str(sdk / "components/kbsp/sdkconfig.board")]
        for d in role_defaults:
            cmd += ["--defaults", str(d)]
        cmd += ["--defaults", str(adef), "--out-h", str(hdr), "--out-config", str(build / "sdkconfig"),
                "--json", str(js)]
        subprocess.run(cmd, check=True)
        stamp.write_text(h)
    commit = sdk_commit(sdk)
    vh = build / "kode_sdk_version.h"
    txt = ('#ifndef KODE_SDK_VERSION_H\n#define KODE_SDK_VERSION_H\n'
           '#define KODE_SDK_VERSION "%s-dotbench"\n#endif\n' % commit)
    if not vh.exists() or vh.read_text() != txt:
        vh.write_text(txt)
    return json.loads(js.read_text())


# ---- compile flags -----------------------------------------------------------------

# Role extras (set by the kodeos role only; empty for apps, so app flags are unchanged)
PRIV_EXTRA = {}       # component -> extra private include globs
INC_EXTRA = []        # extra absolute include dirs (third_party/cJSON, kgui)


def include_dirs(sdk, lvgl, build, comp=None):
    inc = []
    for p in S.PUBLIC_INCLUDES:
        inc.append(sdk / p)
    for g in S.PUBLIC_GLOBS:
        inc += sorted(sdk.glob(g))
    priv = []
    for g in S.PRIVATE_GLOBS.get(comp, []) + PRIV_EXTRA.get(comp, []):
        priv += sorted(sdk.glob(g))
    inc += INC_EXTRA
    rt = [ROOT / "runtime/rtos/include", ROOT / "runtime/idf/include", ROOT / "runtime/bridge",
          ROOT / "runtime/drivers/include", build]
    rt += sorted(p for p in (ROOT / "runtime/drivers").glob("*/include") if p.is_dir())
    return priv + inc + rt + [lvgl, lvgl / "src"]


def base_flags(opt):
    return ["-std=gnu17", "-pthread", opt, "-w", "-include", "stdio.h", "-ffunction-sections", "-fdata-sections",
            "-DESP_PLATFORM", "-DKODE_SYS_INTERNAL_ALLOWED", "-DKODE_INTERNAL_ALLOWED",
            "-DLV_LVGL_H_INCLUDE_SIMPLE", "-DDOTBENCH=1"]


def flags_for(sdk, lvgl, build, comp, opt="-O2"):
    return base_flags(opt) + ["-I" + str(i) for i in include_dirs(sdk, lvgl, build, comp)]


def gen_areas_c(areas):
    """The one generated runtime file: calls every area's chip-registration function."""
    chips = [c for a in areas for c in a.i2c_chips]
    out = ["/* Generated by tools/dotbench from the area manifests. Do not edit. */",
           '#include "dotbench_board.h"']
    out += ["extern void %s(void);" % c for c in chips]
    out += ["void dotbench_register_chips(void)", "{"] + ["    %s();" % c for c in chips] + ["}", ""]
    return "\n".join(out)


# ---- dotbench sdk --------------------------------------------------------------------

def kodeos_dir(a):
    return pathlib.Path(a.kodeos or os.environ.get("DOTBENCH_KODEOS", K.DEFAULT_KODEOS)).resolve()


def setup_role(a, build):
    """The role of this invocation: (role, kodeOS dir or None, the build dir of that role's library set).
    The app role keeps <build> itself; the kodeos role has its own self-contained <build>/kodeos."""
    role = getattr(a, "role", "app")
    if role != "kodeos":
        return "app", None, build
    kos = kodeos_dir(a)
    if not (kos / "components/kgui/CMakeLists.txt").exists():
        sys.exit("dotbench: %s is not a kodeOS checkout (components/kgui missing)" % kos)
    PRIV_EXTRA.update(K.EXTRA_PRIVATE_GLOBS)
    INC_EXTRA[:] = [ROOT / "third_party/cJSON", ROOT / "runtime/drivers/kodeos_boot"]
    rbuild = build / "kodeos"
    rbuild.mkdir(exist_ok=True)
    return "kodeos", kos, rbuild


def cmd_sdk(a):
    sdk, lvgl, emsdk, base_build = paths(a)
    T.activate_emsdk(emsdk)
    role, kos, build = setup_role(a, base_build)
    areas = A.load_areas(ROOT, role)
    replaced = A.superseded(areas)
    if role == "kodeos":
        replaced = {f: r for f, r in replaced.items() if f not in K.UNSUPERSEDE}
    cfg = ensure_config(sdk, lvgl, build, areas, kos)
    obj = build / "obj"
    nproc = a.jobs or os.cpu_count() or 2
    srcs = S.sdk_sources(sdk, cfg)
    if role == "kodeos":
        for comp, files in K.extra_sdk_sources(sdk, cfg).items():
            srcs[comp] = srcs.get(comp, []) + files
    n_real = 0
    groups = {"sdk": [], "lvgl": [], "rt": []}
    if role == "kodeos":
        groups["third"] = []
    for comp, files in srcs.items():
        fl = flags_for(sdk, lvgl, build, comp)
        for f in S.apply_replaced(files, replaced):
            o = obj / "sdk" / (f.replace("/", "__") + ".o")
            groups["sdk"].append((sdk / f, o, fl + (["-ffp-contract=off"] if f.endswith(K.NO_FP_CONTRACT) else [])))
            n_real += 1
    fl = flags_for(sdk, lvgl, build, None)
    for f in S.lvgl_sources(lvgl, cfg):
        groups["lvgl"].append((lvgl / f, obj / "lvgl" / (f.replace("/", "__") + ".o"), fl))
    if role == "kodeos":
        # ThorVG (C++): the vector backend and the Lottie player of Kody. Flags as kui/CMakeLists.txt
        # gives them: LVGL's own config without ThorVG's threads, no exceptions, no RTTI.
        cxx = ["-std=gnu++17", "-pthread", "-O2", "-w", "-fno-exceptions", "-fno-rtti", "-include", "stdio.h", "-include", "stdlib.h",
               "-ffunction-sections", "-fdata-sections", "-DESP_PLATFORM", "-DLV_LVGL_H_INCLUDE_SIMPLE",
               "-DDOTBENCH=1", "-include", str(sdk / "components/kui/thorvg/kui_tvg_config.h")]
        cxx += ["-I" + str(i) for i in include_dirs(sdk, lvgl, build, None)]
        cxx += ["-I" + str(lvgl / "src/libs/thorvg")]
        for f in K.thorvg_sources(lvgl, cfg):
            groups["lvgl"].append((lvgl / f, obj / "lvgl" / (f.replace("/", "__") + ".o"), cxx))
        for f in K.cjson_sources(ROOT):
            groups["third"].append((f, obj / "third" / (f.name + ".o"), fl))
    for f in S.runtime_sources(ROOT, areas):
        groups["rt"].append((ROOT / f, obj / "rt" / (f.replace("/", "__") + ".o"), fl))
    gen = build / "gen"
    gen.mkdir(exist_ok=True)
    gsrc = gen_areas_c(areas)
    if not (gen / "areas_gen.c").exists() or (gen / "areas_gen.c").read_text() != gsrc:
        (gen / "areas_gen.c").write_text(gsrc)
    groups["rt"].append((gen / "areas_gen.c", obj / "rt" / "areas_gen.c.o", fl))
    failed = []
    for g in [g for g in ("rt", "sdk", "lvgl", "third") if g in groups]:
        failed += T.compile_all(groups[g], nproc, g)
    if failed:
        print("dotbench sdk: %d file(s) failed" % len(failed), file=sys.stderr)
        return 1
    # stubs: every declared khal/kdrv function that no compiled object defines
    real_objs = [j[1] for g in groups.values() for j in g]
    defined = T.defined_symbols(real_objs)
    dfile = build / "defined.txt"
    dfile.write_text("\n".join(sorted(defined)))
    stubdir = build / "stubs"
    sfl = fl + ["-I" + str(d) for d in sorted(sdk.glob("components/khal/*/src"))]
    subprocess.run([sys.executable, str(ROOT / "tools/gen_stubs.py"), "--sdk", str(sdk),
                    "--defined", str(dfile), "--out", str(stubdir),
                    "--cpp-flags", " ".join(x for x in sfl if x.startswith(("-I", "-D")))], check=True)
    stub_jobs = [(p, obj / "stubs" / (p.name + ".o"), sfl) for p in sorted(stubdir.glob("*.c"))]
    failed = T.compile_all(stub_jobs, nproc, "stubs")
    if failed:
        return 1
    lib = build / "lib"
    lib.mkdir(exist_ok=True)
    archives = [("libdotbench_sdk.a", groups["sdk"]), ("libdotbench_lvgl.a", groups["lvgl"]),
                ("libdotbench_rt.a", groups["rt"]), ("libdotbench_stubs.a", stub_jobs)]
    if "third" in groups:
        archives.append(("libdotbench_third.a", groups["third"]))
    for name, jobs in archives:
        T.make_archive(lib / name, [j[1] for j in jobs])
    meta = {"sdk_commit": sdk_commit(sdk), "emscripten": T.emcc_version(),
            "real_sdk_files": n_real, "lvgl_files": len(groups["lvgl"]),
            "stub_functions": sum(p.read_text().count("DOTBENCH_UNIMPLEMENTED(") for p in stubdir.glob("*.c")),
            "areas": [a.name for a in areas], "replaced": replaced}
    meta["role"] = role
    (build / "sdk-meta.json").write_text(json.dumps(meta, indent=1))
    T.save_hash_cache(base_build / "hashcache.json")
    print("dotbench sdk: done (%d real SDK files, %d LVGL files, %d stub functions)"
          % (n_real, len(groups["lvgl"]), meta["stub_functions"]))
    return 0


# ---- dotbench build --------------------------------------------------------------------

def parse_component(appdir):
    cm = (appdir / "main" / "CMakeLists.txt").read_text()
    m = re.search(r"idf_component_register\s*\((.*?)\n\)", cm, re.S) or re.search(r"idf_component_register\s*\((.*?)\)", cm, re.S)
    if not m:
        sys.exit("dotbench: no idf_component_register() in %s" % (appdir / "main/CMakeLists.txt"))
    body = re.sub(r"#[^\n]*", "", m.group(1))
    toks = re.findall(r'"[^"]*"|[^\s"]+', body)
    cur, d = None, {}
    for t in toks:
        if re.fullmatch(r"[A-Z_]+", t):
            cur = t
            d.setdefault(cur, [])
        elif cur:
            d[cur].append(t.strip('"'))
    return d


def app_name(appdir):
    cm = (appdir / "CMakeLists.txt").read_text()
    m = re.search(r"project\s*\(\s*([\w\-]+)", cm)
    return m.group(1) if m else appdir.name


def png_placeholder(path, size=64):
    import struct
    import zlib
    raw = b"".join(b"\x00" + bytes([0x20, 0x60, 0xB0, 0xFF]) * size for _ in range(size))

    def chunk(t, d):
        c = struct.pack(">I", len(d)) + t + d
        return c + struct.pack(">I", zlib.crc32(t + d) & 0xFFFFFFFF)
    data = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 6, 0, 0, 0)) \
        + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b"")
    pathlib.Path(path).write_bytes(data)


def cmd_build(a):
    sdk, lvgl, emsdk, base_build = paths(a)
    T.activate_emsdk(emsdk)
    appdir = pathlib.Path(a.app).resolve()
    role, kos, build = setup_role(a, base_build)
    if role == "kodeos":
        if appdir != kos and not a.kodeos:
            kos = appdir
            a.kodeos = str(appdir)
            role, kos, build = setup_role(a, base_build)
        rc = cmd_sdk(a)      # incremental: only what changed is compiled
        if rc:
            return rc
    lib = build / "lib"
    names = ["libdotbench_sdk.a", "libdotbench_lvgl.a", "libdotbench_rt.a", "libdotbench_stubs.a"]
    if role == "kodeos":
        names.append("libdotbench_third.a")
    libs = [lib / n for n in names]
    if not all(p.exists() for p in libs):
        sys.exit("dotbench: run `dotbench sdk` first (static libraries missing in %s)" % lib)
    areas = A.load_areas(ROOT, role)
    cfg = ensure_config(sdk, lvgl, build, areas, kos)
    name = app_name(appdir)
    reg = parse_component(appdir)
    main = appdir / "main"
    srcs = [main / s for s in reg.get("SRCS", [])]
    for d in reg.get("SRC_DIRS", []):
        srcs += sorted((main / d).glob("*.c"))
    incs = [main / d for d in reg.get("INCLUDE_DIRS", ["."]) + reg.get("PRIV_INCLUDE_DIRS", [])]
    outdir = pathlib.Path(a.output).resolve() if a.output else base_build / "apps" / name
    outdir.mkdir(parents=True, exist_ok=True)
    objdir = build / "obj" / "app" / name
    fl = flags_for(sdk, lvgl, build, None, "-O2") + ["-I" + str(i) for i in incs]
    if role == "kodeos":
        fl = fl + ["-I" + str(i) for i in K.kgui_includes(kos)]       # main.c includes kgui.h
    jobs = [(s, objdir / (s.name + ".o"), fl) for s in srcs]
    if role == "kodeos":
        # kgui: kodeOS's own component (components/kgui), compiled like main
        kfl = flags_for(sdk, lvgl, build, None, "-O2") + ["-I" + str(i) for i in K.kgui_includes(kos)] + K.compat_flags(ROOT)
        for s in K.kgui_sources(kos, cfg):
            rel = s.relative_to(kos / "components/kgui").as_posix().replace("/", "__")
            jobs.append((s, build / "obj" / "kgui" / (rel + ".o"), kfl))
    if T.compile_all(jobs, a.jobs or os.cpu_count() or 2, "app " + name):
        return 1
    exports = A.exports(areas)
    mem = a.memory_mb or (K.MEMORY_MB if role == "kodeos" else 96)
    pool = a.pool or (K.POOL if role == "kodeos" else 44)
    js = outdir / (name + ".js")
    tool = "em++" if role == "kodeos" else "emcc"   # C++ (ThorVG) needs libc++ on the link line
    link = [tool] + [str(j[1]) for j in jobs] + [str(p) for p in libs] + [
        "-o", str(js), "-pthread", "-O2", "-sPROXY_TO_PTHREAD", "-sMODULARIZE", "-sEXPORT_ES6",
        "-sEXPORT_NAME=createDotbench", "-sENVIRONMENT=web,worker,node",
        "-sINITIAL_MEMORY=%dMB" % mem, "-sALLOW_MEMORY_GROWTH=0", "-sSTACK_SIZE=%s" % (K.MAIN_STACK if role == "kodeos" else "1MB"),
        "-sDEFAULT_PTHREAD_STACK_SIZE=256KB", "-sPTHREAD_POOL_SIZE=%d" % pool, "-sEXIT_RUNTIME=0",
        "-sEXPORTED_FUNCTIONS=" + ",".join(exports),
        "-sEXPORTED_RUNTIME_METHODS=PThread,callMain,HEAPU8,HEAP32,HEAPU32,wasmMemory,ccall,cwrap,UTF8ToString,stringToUTF8,lengthBytesUTF8",
        "-sERROR_ON_UNDEFINED_SYMBOLS=%d" % (0 if a.allow_undefined else 1),
        "-Wl,--gc-sections", "-Wl,--wrap=gettimeofday", "-Wl,--error-limit=0", "-Wno-pthreads-mem-growth",
    ]
    if a.allow_undefined:
        link.append("-Wl,--unresolved-symbols=ignore-all")
    if role == "kodeos":
        link += ["-Wl,--wrap=" + w for w in K.LINK_WRAPS]
    if role == "kodeos" or a.map:
        link.append("-Wl,-Map=" + str(outdir / (name + ".map")))     # which stubs the firmware really references
    r = subprocess.run(link, capture_output=True, text=True)
    sys.stderr.write(r.stderr[-6000:])
    if r.returncode:
        print("dotbench build: link failed", file=sys.stderr)
        return 1
    # ---- package ----
    wasm = outdir / (name + ".wasm")
    extra = [p for p in (outdir / (name + ".worker.js"),) if p.exists()]
    manifest_re = re.search(r'KODE_APP_MANIFEST\(\s*"([^"]*)"\s*,\s*"([^"]*)"', "\n".join(s.read_text() for s in srcs))
    display, category = (manifest_re.group(1), manifest_re.group(2)) if manifest_re else (name, "")
    version = "0.0.0"
    yml = main / "idf_component.yml"
    if yml.exists():
        m = re.search(r"^version:\s*\"?([\w.\-]+)", yml.read_text(), re.M)
        if m:
            version = m.group(1)
    version = AD.project_version(appdir, version)      # set(PROJECT_VER "...") of the CMakeLists wins, as on the board
    board = AD.board_folder(appdir, kodeos_dir(a), "") if role == "app" else None
    icon = appdir / "icon.png"
    icon_out = outdir / "icon.png"
    if icon.exists():
        icon_out.write_bytes(icon.read_bytes())
    else:
        png_placeholder(icon_out)
    app_json = {"name": name, "display_name": display, "category": category, "version": version,
                "entry": name + ".js", "wasm": name + ".wasm", "icon": "icon.png"}
    manifest = {"format": 1, "name": name, "sdk_commit": sdk_commit(sdk), "pinned_sdk_commit": PINNED_SDK_COMMIT,
                "emscripten": T.emcc_version(), "abi_version": 1,
                "js": name + ".js", "wasm": name + ".wasm", "workers": [p.name for p in extra],
                "memory_mb": mem, "exports": exports, "state_export": "_kweb_state",
                "areas": {a.name: {"glue": ["glue/%s/%s" % (a.name, pathlib.Path(g).name) for g in a.js]}
                          for a in areas if a.js}}
    if board:
        manifest["board"] = {"app_json": "board/app.json", "icon": "board/icon.k64" if board[1] else None}
    factory = []
    if role == "kodeos":
        manifest["role"] = "kodeos"
        manifest["pool_size"] = pool
        manifest["kodeos_commit"] = K.git_commit(kos)
        factory = K.factory_files(sdk, kos)
        manifest["factory"] = {"volume": "storage", "files": K.factory_manifest(factory)}
    pkg = outdir / (name + ".dotbench")
    with zipfile.ZipFile(pkg, "w", zipfile.ZIP_DEFLATED) as z:
        z.write(js, name + ".js")
        z.write(wasm, name + ".wasm")
        for p in extra:
            z.write(p, p.name)
        for a in areas:
            for g in a.js:
                z.write(a.dir / g, "glue/%s/%s" % (a.name, pathlib.Path(g).name))
        z.writestr("appdata/app.json", json.dumps(app_json, indent=1))
        z.write(icon_out, "icon.png")
        if board:
            z.writestr("board/app.json", board[0])
            if board[1]:
                z.writestr("board/icon.k64", board[1])
        for rel, src in factory:
            z.write(src, "factory/storage/" + rel)
        z.writestr("manifest.json", json.dumps(manifest, indent=1))
    T.save_hash_cache(base_build / "hashcache.json")
    # The same package under the name people share and install: an app package is a plain zip.
    # (<name>.dotbench stays beside it: tests and the site's factory list still read that name.)
    zip_pkg = outdir / (name + ".zip")
    shutil.copyfile(pkg, zip_pkg)
    print("dotbench build: %s (%d bytes)" % (zip_pkg, zip_pkg.stat().st_size))
    return 0


def cmd_part(a):
    """`dotbench part ...` runs tools/dblib/part/cli.mjs on Node (no npm packages). Needs Node 22+ (zlib.crc32)."""
    node = shutil.which("node")
    if not node:
        sys.exit("dotbench part: Node.js 22 or newer is needed (https://nodejs.org)")
    env = dict(os.environ)
    if a.emsdk:
        env["DOTBENCH_EMSDK"] = a.emsdk
    cli = pathlib.Path(__file__).resolve().parent / "dblib" / "part" / "cli.mjs"
    return subprocess.call([node, str(cli)] + a.rest, env=env)


def cmd_seed(a):
    """Copy an existing build directory into --build and fix the paths inside, so that a new
    worktree starts with every SDK/LVGL object already compiled (staleness is by content hash)."""
    src = pathlib.Path(a.source).resolve()
    meta = src / "build-meta.json"
    if not meta.exists():
        sys.exit("dotbench: %s is not a dotbench build directory (no build-meta.json)" % src)
    old = json.loads(meta.read_text())
    sdk, lvgl, emsdk, build = paths(a)
    if build == src:
        sys.exit("dotbench: source and destination are the same directory")
    import shutil
    n = 0
    for p in sorted(src.rglob("*")):
        rel = p.relative_to(src)
        if rel.parts[0] in ("apps", "rtos-test"):
            continue
        t = build / rel
        if p.is_dir():
            t.mkdir(parents=True, exist_ok=True)
            continue
        t.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(p, t)
        if p.suffix == ".d":
            txt = t.read_text()
            txt = txt.replace(old["build"], str(build)).replace(old["root"], str(ROOT))
            t.write_text(txt)
        n += 1
    (build / "build-meta.json").write_text(json.dumps({"root": str(ROOT), "build": str(build)}))
    print("dotbench seed: copied %d files from %s to %s; run `dotbench sdk` to bring it up to date" % (n, src, build))
    return 0


def cmd_areas(a):
    areas = A.load_areas(ROOT)
    if a.json:
        print(json.dumps([{"area": x.name, "dir": str(x.dir), "test_apps": x.test_apps, "js": x.js,
                           "tests": sorted(str(t) for t in (ROOT / "tests/node" / x.name).glob("*.test.mjs"))}
                          for x in areas]))
        return 0
    for x in areas:
        print("%-10s %2d sources, %d superseded, chips=%s, exports=%d, js=%d  %s" % (
            x.name, len(x.sources), len(x.supersedes), ",".join(x.i2c_chips) or "-", len(x.exports),
            len(x.js), x.data.get("description", "")))
    return 0


def main():
    ap = argparse.ArgumentParser(prog="dotbench", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--sdk"); ap.add_argument("--lvgl"); ap.add_argument("--emsdk"); ap.add_argument("--build")
    ap.add_argument("--kodeos", help="kodeOS checkout for --role kodeos (env DOTBENCH_KODEOS)")
    ap.add_argument("-j", "--jobs", type=int)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sdk_p = sub.add_parser("sdk")
    sdk_p.add_argument("--role", choices=("app", "kodeos"), default="app")
    sd = sub.add_parser("seed", help="copy an existing build dir into --build (fast start for a new worktree)")
    sd.add_argument("source")
    ar = sub.add_parser("areas", help="list the hardware areas discovered under runtime/drivers")
    ar.add_argument("--json", action="store_true")
    b = sub.add_parser("build")
    b.add_argument("app")
    b.add_argument("-o", "--output")
    b.add_argument("--role", choices=("app", "kodeos"), default="app",
                   help="app (default) or kodeos: build kodeOS itself (APPDIR is the kodeOS checkout)")
    b.add_argument("--memory-mb", type=int, default=None, help="wasm memory, MB (default 96, also for --role kodeos)")
    b.add_argument("--pool", type=int, default=None, help="pthread pool size (default 44, measured peak of the factory apps 30; kodeos: see dblib/kodeos.py)")
    b.add_argument("--map", action="store_true", help="also write a linker map next to the output (kodeos always does)")
    b.add_argument("--allow-undefined", action="store_true", help="link with unresolved symbols ignored (diagnostics)")
    pt = sub.add_parser("part", help="make parts for the bench: new, check, build, test, inspect (run `dotbench part` for details)")
    pt.add_argument("rest", nargs=argparse.REMAINDER)
    a = ap.parse_args()
    return {"part": cmd_part, "sdk": cmd_sdk, "build": cmd_build, "seed": cmd_seed, "areas": cmd_areas}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())

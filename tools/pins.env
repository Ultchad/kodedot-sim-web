# The pinned upstream versions of dotbench. Plain KEY=VALUE, read by tools/setup.sh and tools/upstream-*.sh.
# tools/upstream-update.sh rewrites this file when it moves to a newer release; edit by hand only to pin something else.
# A TAG is what a person reads, the COMMIT is what setup.sh checks the tag resolves to (a moved tag fails the setup).
KODE_SDK_TAG=v0.1.5
KODE_SDK_COMMIT=d775f3df7472cf20c5e41b701f49e65c28d7e15b
KODEOS_TAG=v0.1.5
KODEOS_COMMIT=b500326bcf97ebb1de1879b412a3d4131fbfb076
# Kody Kart has no release tags: pinned by commit (its HEAD, "Build against kode-sdk v0.1.1")
KODY_KART_COMMIT=4ee77321442035c35da4dd3994e5cdef055564db
# KodeCity has no release tags either: pinned by commit ("KodeCity 0.1.0: an open-world 3D city for the Kode Dot")
KODECITY_COMMIT=f0b024d07d36c2d6cc99e4fb370f5e588b86d023
LVGL_TAG=v9.6.0
EMSDK_VERSION=7.0.0
